    "testing.iconFailed": "#d36151",
    "symbolIcon.functionForeground": "#5b79e3",
    "symbolIcon.methodForeground": "#5b79e3",
    "symbolIcon.classForeground": "#3882b7",
    "symbolIcon.variableForeground": "#242529",
    "symbolIcon.propertyForeground": "#d3604f",
    "symbolIcon.keywordForeground": "#a449ab",
    "symbolIcon.stringForeground": "#649f57",
    "symbolIcon.numberForeground": "#ad6e25",
    "symbolIcon.constantForeground": "#c18401"
  },
  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "variable", "meta.definition.variable"],
      "settings": { "foreground": "#242529" }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#a2a3a7" }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": { "foreground": "#7c7e86" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#649f57" }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape", "string.escape"],
      "settings": { "foreground": "#7c7e86" }
    },
    {
      "name": "Regex / special string",
      "scope": [
        "string.regexp",
        "string.other.link.regexp",
        "constant.other.symbol",
        "string.other.symbol"
      ],
      "settings": { "foreground": "#ad6e26" }
    },
    {
      "name": "Number / boolean",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language",
        "variable.language",
        "variable.parameter.function.language.special"
      ],
      "settings": { "foreground": "#ad6e25" }
    },
    {
      "name": "Constant",
      "scope": [
        "variable.other.constant",
        "support.constant",
        "constant.other",
        "entity.name.constant"
      ],
      "settings": { "foreground": "#c18401" }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import"
      ],
      "settings": { "foreground": "#a449ab" }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": { "foreground": "#3882b7" }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": { "foreground": "#5b79e3" }
    },
    {
      "name": "Constructor / variant",
      "scope": ["entity.name.function.constructor", "meta.enum variable.other.enummember"],
      "settings": { "foreground": "#5c78e2" }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": { "foreground": "#3882b7" }
    },
    {
      "name": "Enum member",
      "scope": ["variable.other.enummember"],
      "settings": { "foreground": "#3882b7" }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package"],
      "settings": { "foreground": "#242529" }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "variable.object.property"
      ],
      "settings": { "foreground": "#d3604f" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameters variable"],
      "settings": { "foreground": "#d3604f" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#242529" }
    },
    {
      "name": "Brackets / delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": { "foreground": "#4d4f52" }
    },
    {
      "name": "Special punctuation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#b92b46" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#5c78e2" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#5c78e2" }
    },
    {
      "name": "Label",
      "scope": ["entity.name.label", "punctuation.definition.label"],
      "settings": { "foreground": "#5c78e2" }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "meta.selector"
      ],
      "settings": { "foreground": "#669f59" }
    },
    {
      "name": "CSS pseudo selector",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#5c78e2" }
    },
    {
      "name": "Embedded",
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": { "foreground": "#242529" }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": { "foreground": "#d3604f" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "#ad6e25", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "#5c78e2", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline / raw",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#649f57" }
    },
    {
      "name": "Markdown link text",
      "scope": ["string.other.link.title", "string.other.link.description", "markup.link"],
      "settings": { "foreground": "#5b79e3", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link URI",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#3882b7", "fontStyle": "" }
    },
    {
      "name": "Markdown list marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown",
        "markup.list punctuation.definition"
      ],
      "settings": { "foreground": "#d3604f" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote", "punctuation.definition.quote.begin.markdown"],
      "settings": { "foreground": "#7c7e86" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "#50a14f" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "#e45649" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#d36151" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#242529",
    "type": "#3882b7",
    "class": "#3882b7",
    "enum": "#3882b7",
    "interface": "#3882b7",
    "struct": "#3882b7",
    "typeParameter": "#3882b7",
    "enumMember": "#3882b7",
    "function": "#5b79e3",
    "method": "#5b79e3",
    "macro": "#a449ab",
    "variable": "#242529",
    "variable.constant": "#c18401",
    "variable.defaultLibrary": "#ad6e25",
    "parameter": "#d3604f",
    "property": "#d3604f",
    "keyword": "#a449ab",
    "string": "#649f57",
    "number": "#ad6e25",
    "regexp": "#ad6e26",
    "operator": "#3882b7",
    "comment": "#a2a3a7"
  }
}

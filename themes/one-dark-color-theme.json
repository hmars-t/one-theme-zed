    "testing.iconPassed": "#a1c181",
    "testing.iconFailed": "#d07277",
    "symbolIcon.functionForeground": "#73ade9",
    "symbolIcon.methodForeground": "#73ade9",
    "symbolIcon.classForeground": "#6eb4bf",
    "symbolIcon.variableForeground": "#acb2be",
    "symbolIcon.propertyForeground": "#d07277",
    "symbolIcon.keywordForeground": "#b477cf",
    "symbolIcon.stringForeground": "#a1c181",
    "symbolIcon.numberForeground": "#bf956a",
    "symbolIcon.constantForeground": "#dfc184"
  },
  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "variable", "meta.definition.variable"],
      "settings": { "foreground": "#acb2be" }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5d636f" }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": { "foreground": "#878e98" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#a1c181" }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape", "string.escape"],
      "settings": { "foreground": "#878e98" }
    },
    {
      "name": "Regex / special string",
      "scope": [
        "string.regexp",
        "string.other.link.regexp",
        "constant.other.symbol",
        "string.other.symbol"
      ],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "name": "Number / boolean",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language",
        "variable.language",
        "variable.parameter.function.language.special"
      ],
      "settings": { "foreground": "#bf956a" }
    },
    {
      "name": "Constant",
      "scope": [
        "variable.other.constant",
        "support.constant",
        "constant.other",
        "entity.name.constant"
      ],
      "settings": { "foreground": "#dfc184" }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import"
      ],
      "settings": { "foreground": "#b477cf" }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": { "foreground": "#6eb4bf" }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": { "foreground": "#73ade9" }
    },
    {
      "name": "Constructor / variant",
      "scope": ["entity.name.function.constructor", "meta.enum variable.other.enummember"],
      "settings": { "foreground": "#73ade9" }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": { "foreground": "#6eb4bf" }
    },
    {
      "name": "Enum member",
      "scope": ["variable.other.enummember"],
      "settings": { "foreground": "#6eb4bf" }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package"],
      "settings": { "foreground": "#dce0e5" }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "variable.object.property"
      ],
      "settings": { "foreground": "#d07277" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameters variable"],
      "settings": { "foreground": "#d07277" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#acb2be" }
    },
    {
      "name": "Brackets / delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": { "foreground": "#b2b9c6" }
    },
    {
      "name": "Special punctuation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#b1574b" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#74ade8" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#74ade8" }
    },
    {
      "name": "Label",
      "scope": ["entity.name.label", "punctuation.definition.label"],
      "settings": { "foreground": "#74ade8" }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "meta.selector"
      ],
      "settings": { "foreground": "#dfc184" }
    },
    {
      "name": "CSS pseudo selector",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#74ade8" }
    },
    {
      "name": "Embedded",
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": { "foreground": "#dce0e5" }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": { "foreground": "#d07277" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "#bf956a", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "#74ade8", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline / raw",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#a1c181" }
    },
    {
      "name": "Markdown link text",
      "scope": ["string.other.link.title", "string.other.link.description", "markup.link"],
      "settings": { "foreground": "#73ade9", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link URI",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#6eb4bf", "fontStyle": "" }
    },
    {
      "name": "Markdown list marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown",
        "markup.list punctuation.definition"
      ],
      "settings": { "foreground": "#d07277" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote", "punctuation.definition.quote.begin.markdown"],
      "settings": { "foreground": "#878e98" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "#98c379" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "#e06c75" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#d07277" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#dce0e5",
    "type": "#6eb4bf",
    "class": "#6eb4bf",
    "enum": "#6eb4bf",
    "interface": "#6eb4bf",
    "struct": "#6eb4bf",
    "typeParameter": "#6eb4bf",
    "enumMember": "#6eb4bf",
    "function": "#73ade9",
    "method": "#73ade9",
    "macro": "#b477cf",
    "variable": "#acb2be",
    "variable.constant": "#dfc184",
    "variable.defaultLibrary": "#bf956a",
    "parameter": "#d07277",
    "property": "#d07277",
    "keyword": "#b477cf",
    "string": "#a1c181",
    "number": "#bf956a",
    "regexp": "#bf956a",
    "operator": "#6eb4bf",
    "comment": "#5d636f"
  }
}
